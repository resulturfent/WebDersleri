<!--
    table template
    https://bootsnipp.com/snippets/P2eO9
-->
@using DLL.EntitiesTablolar

@model List<Kategoriler>

<div class="row">
    <div class="col-lg-12 col-md-12 ">
        <div class="row">
            <div class="col-10">
                <h4><small>Kategori İşlemleri</small> </h4>
            </div>
            <div class="col-2">
                <a asp-action="Ekle" asp-controller="Kategori" class="btn btn-sm btn-success">Ekle</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th>Kategori Adı</th>
                        <th>Ürün Sayısı</th>
                        <th>İşlem</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td>@item.Adi</td>
                            <td class="text-right">0</td>
                            <td class="td-actions text-right">
                                <button type="button" rel="tooltip" class="btn btn-info btn-just-icon btn-sm" data-original-title="" title="">
                                    <i class="material-icons">person</i>
                                </button>
                                <button type="button" rel="tooltip" class="btn btn-success btn-just-icon btn-sm" data-original-title="" title="">
                                    <i class="material-icons">edit</i>
                                </button>
                                <button type="button" rel="tooltip" class="btn btn-danger btn-just-icon btn-sm" data-original-title="" title="">
                                    <i class="material-icons">close</i>
                                </button>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

   


    
   
