@model DLL.EntitiesTablolar.Kategoriler

@{
    ViewData["Title"] = "Kategori Ekle";
}

<div class="container mt-4">
    <h2>Yeni Kategori Ekle</h2>
    <hr />

    <div class="row">
        <div class="col-md-6 col-lg-4">
            <form asp-action="Ekle" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Adi" class="control-label fw-bold">Kategori Adı</label>
                    <input asp-for="Adi" class="form-control" placeholder="Kategori adını giriniz..." />
                    <span asp-validation-for="Adi" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary px-4 me-2">
                        <i class="bi bi-plus-circle"></i> Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}